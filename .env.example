# Supabase (project "Talentrah", id nytwbbzfpytctjsoczzq)
NEXT_PUBLIC_SUPABASE_URL=https://nytwbbzfpytctjsoczzq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Used by webhook handlers and
# background jobs that must bypass RLS (payments, credit ledger, aggregation).
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider selection (src/lib/llm/) — "gemini" (default if unset) or
# "groq". Every LLM call (Farah chat, tailoring/gap analysis, the
# resume-parse fallback) goes through whichever this picks; no per-call-site
# config needed. Recommended: "groq" for local dev/CI (genuinely free,
# avoids Gemini's shared 20-req/day cap blocking everyone), "gemini" for
# Preview/Production until a real output-quality comparison says otherwise.
LLM_PROVIDER=gemini

# Gemini (Google AI Studio) — src/lib/llm/gemini-provider.ts. Get one at
# https://aistudio.google.com/apikey. As of mid-2026, AI Studio issues
# "Auth" keys starting "AQ." rather than the older "AIzaSy" Standard format
# — both work against the native REST endpoint used here, but Standard keys
# stop working entirely in September 2026 per Google's docs
# (https://ai.google.dev/gemini-api/docs/api-key). Use whichever format AI
# Studio gives you; do not assume "AQ." is a paste error.
GEMINI_API_KEY=

# Groq — src/lib/llm/groq-provider.ts. OpenAI-SDK-compatible; get one at
# https://console.groq.com/keys. Only read when LLM_PROVIDER=groq.
GROQ_API_KEY=

# Paystack — credit pack / pass checkout + webhooks (build-prompt §6.9).
# Webhook signatures are HMAC-SHA512'd with this same secret key — Paystack
# has no separate webhook-signing secret the way Stripe does. Secret key is
# server-only (src/lib/paystack/client.ts is "server-only"); the public key
# is NEXT_PUBLIC_-prefixed per Next.js convention but currently unused —
# checkout is a full-page redirect to Paystack's hosted page, not the inline
# JS widget that would need it in the browser.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# OAuth providers — configured entirely on Supabase's side (Authentication >
# Providers: client ID/secret, redirect URLs). The app never sees those
# client secrets; it only calls supabase.auth.signInWithOAuth() with a
# provider name ("google", "linkedin_oidc") — see src/lib/auth/actions.ts.
# Nothing to set here.

# Resend — sends the Contact page form (src/lib/contact/actions.ts) to
# CONTACT_EMAIL_TO. If unset, the form shows a graceful error pointing
# visitors at the mailto fallback on the page instead of failing silently.
RESEND_API_KEY=
CONTACT_EMAIL_TO=support@talentrah.com

# Marketing footer — "Join the community" and "Follow us" links
# (src/components/marketing/marketing-footer.tsx). Not secrets — safe as
# plain (non-Sensitive) env vars in Vercel/GitHub Actions. Each link only
# renders if its var is set to a non-empty value; leave unset to omit a
# platform whose account isn't live yet.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_THREADS_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_REDDIT_URL=

# Job aggregation pipeline (src/lib/jobs). INGEST_SECRET is optional locally
# (unauthenticated if unset) but should be set once /api/admin/ingest-jobs is
# wired to a real scheduler (Vercel Cron) so it isn't a public trigger.
INGEST_SECRET=
# Pass auto-renewal job (src/lib/billing/renewals.ts), manual/admin trigger
# only — same pattern as INGEST_SECRET above. Optional locally
# (unauthenticated if unset); guards the POST path of
# /api/admin/renew-passes. The scheduled path uses CRON_SECRET instead.
PASS_RENEWAL_SECRET=
# Vercel Cron auth for the scheduled Pass renewal run (GET
# /api/admin/renew-passes, schedule in vercel.json). The name is fixed by
# Vercel, not our choice: setting CRON_SECRET on the project makes Vercel
# send it automatically as "Authorization: Bearer <value>" on every cron
# invocation. Vercel recommends a random string of 16+ characters. Set in
# Vercel's Production environment; unset locally the GET path fails closed.
CRON_SECRET=
# Only read by scripts/seed.ts, to know where the dev server is listening.
SEED_APP_URL=http://localhost:3000

# Password for the seeded demo account (demo@talentrah.dev), used by
# scripts/seed.ts and the masthead-nav e2e spec. Deliberately has no default:
# it was previously a literal in the repo, which is public, and that account is
# the verified owner of the demo organisation whose postings are in the live
# feed. Pick a strong value; set the same one as a CI secret so the e2e job can
# log in. Re-running the seed re-asserts it on the existing account.
DEMO_PASSWORD=

# Set to 1 only when you intend to CHANGE the password of accounts that already
# exist: `SEED_ROTATE_PASSWORDS=1 npm run seed`. Left unset (including in CI),
# the seed creates missing accounts but never rewrites an existing password.
# That gate exists because CI seeds the LIVE project — without it, any pull
# request could set the demo account's password by editing scripts/seed.ts.
SEED_ROTATE_PASSWORDS=
