# Supabase (project "Talentrah", id nytwbbzfpytctjsoczzq)
NEXT_PUBLIC_SUPABASE_URL=https://nytwbbzfpytctjsoczzq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Used by webhook handlers and
# background jobs that must bypass RLS (payments, credit ledger, aggregation).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API — JD structuring, gap analysis, tailoring, Farah chat,
# and the low-confidence fallback in resume parsing.
ANTHROPIC_API_KEY=

# Gemini — key stored for a future integration; nothing in this codebase
# calls it yet (all current AI features go through Anthropic Claude, see
# src/lib/farah). Do not wire this up without confirming the intended use.
GEMINI_API_KEY=

# Paystack — credit pack / pass checkout + webhooks (build-prompt §6.9).
# Webhook signatures are HMAC-SHA512'd with this same secret key — Paystack
# has no separate webhook-signing secret the way Stripe does. Secret key is
# server-only (src/lib/paystack/client.ts is "server-only"); the public key
# is NEXT_PUBLIC_-prefixed per Next.js convention but currently unused —
# checkout is a full-page redirect to Paystack's hosted page, not the inline
# JS widget that would need it in the browser.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# OAuth providers — configured entirely on Supabase's side (Authentication >
# Providers: client ID/secret, redirect URLs). The app never sees those
# client secrets; it only calls supabase.auth.signInWithOAuth() with a
# provider name ("google", "linkedin_oidc") — see src/lib/auth/actions.ts.
# Nothing to set here.

# Job aggregation pipeline (src/lib/jobs). INGEST_SECRET is optional locally
# (unauthenticated if unset) but should be set once /api/admin/ingest-jobs is
# wired to a real scheduler (Vercel Cron) so it isn't a public trigger.
INGEST_SECRET=
# Only read by scripts/seed.ts, to know where the dev server is listening.
SEED_APP_URL=http://localhost:3000
